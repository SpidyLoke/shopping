# Backend settings (see index.js). Deploying without a terminal to answer prompts needs every
# setting given here. Per-project overrides go in .env.<project-id> (the Deploy backend workflow
# writes one from repository variables).
FREE_SCANS=10
PRO_SCANS=100
PASS_SCANS=60
PASS_DAYS=14
DAILY_SCANS=500
PER_IP_SCANS=40
FREE_ASKS=40
PRO_ASKS=1000
DAILY_ASKS=2000
GEMINI_MODEL=gemini-flash-latest
CACHE_DAYS=7
APP_URL=https://spidyloke.github.io/shopping/
# Account IDs allowed on the beta dashboard, comma-separated ("none" until one is set).
OWNER_UIDS=none
