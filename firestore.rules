rules_version = '2';
// The app reads nothing from Firestore directly except your own allowance; the backend (functions/)
// writes everything with admin access, which these rules don't limit.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
    }
  }
}
